{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openclaw-agent-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-12",
  "observability": { "enabled": true },
  "vars": {
    "EDGE_TOKEN_AUDIENCE": "openclaw-agent-relay",
    "GATEWAY_WS_URL": "wss://gateway.example.invalid",
    "APPLE_APP_ID": "TEAMID.ai.openclaw.ios",
    "RELAY_PUBLIC_URL": "https://relay.example.invalid",
  },
  "durable_objects": {
    "bindings": [{ "name": "AGENT_RELAY_GUARD", "class_name": "AgentRelayGuard" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AgentRelayGuard"] }],
}
